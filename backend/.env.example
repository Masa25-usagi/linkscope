# X (Twitter) 認証クッキー
# ブラウザの開発者ツール (F12) > Application > Cookies > x.com から取得
AUTH_TOKEN=
CT0=

# スコアリング重み設定
W_MUTUAL=0.45
W_INBOUND=0.25
W_OUTBOUND=0.15
FOLLOWER_PENALTY_LAMBDA=0.08
SIMILARITY_BONUS_MAX=0.15

# レート制限・抽出設定
REQUEST_DELAY_SECONDS=1.5
MAX_CLOSE_FRIENDS=10
MIN_CLOSE_FRIENDS=3
MAX_TWEETS_TO_ANALYZE=40
